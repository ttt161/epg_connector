[
    {epg_connector, [
        {databases, #{
            default_db => #{
                host => "postgres",
                port => 5432,
                database => "connector_db",
                username => "connector",
                password => "connector"
            }
        }},
        {pools, #{
            default_pool => #{
                database => default_db,
                size => {1, 10}
            },
            front_pool => #{
                database => default_db,
                size => 10
            },
            back_pool => #{
                database => default_db,
                size => 10
            },
            vip_pool => #{
                database => default_db,
                size => 10
            }
        }},
        {async, enabled},
        {force_garbage_collect, false}
    ]}
].
